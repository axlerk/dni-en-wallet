{
  "name": "dni-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Copia de referencia del DNI como pase de Apple Wallet (.pkpass). PWA en JS puro + servidor de firma mínimo.",
  "license": "MIT",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "vendor": "node -e \"const fs=require('fs');fs.mkdirSync('public/vendor',{recursive:true});fs.copyFileSync('node_modules/@zxing/library/umd/index.min.js','public/vendor/zxing-library.min.js')\"",
    "postinstall": "npm run vendor",
    "assets": "node scripts/gen-pass-assets.mjs",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "secrets": "sh scripts/put-secrets.sh",
    "stats": "node scripts/stats.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@zxing/library": "^0.21.3"
  },
  "devDependencies": {
    "wrangler": "^4.131.1"
  }
}
